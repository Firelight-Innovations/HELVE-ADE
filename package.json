{
  "name": "helve-orchestrator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode agent",
    "build": "pnpm run build:bridge && pnpm run generate:icons && pnpm run build:file-icons && pnpm run build:monaco-languages && tsc && vite build",
    "build:bridge": "pnpm --filter @helve/bridge build",
    "build:file-icons": "pnpm --filter @helve/file-icons build",
    "build:monaco-languages": "pnpm --filter @helve/monaco-languages build",
    "generate:icons": "node scripts/generate-file-icons.mjs",
    "postinstall": "pnpm run generate:icons",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@helve/bridge": "workspace:*",
    "@helve/file-icons": "workspace:*",
    "@helve/monaco-languages": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^13.1.0",
    "material-icon-theme": "^5.37.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
